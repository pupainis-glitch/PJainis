rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== REIZRĒĶINA SALA — sākums =====
    // Ja projektā jau ir citi noteikumi, iekopē tikai šo bloku (līdz "beigas")
    // iekšā esošajā "match /databases/{database}/documents { ... }".

    match /sala_users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || (request.auth.token.email == "pupainis@gmail.com" && request.auth.token.email_verified == true));
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.token.email == "pupainis@gmail.com" && request.auth.token.email_verified == true;

      match /sala_rounds/{roundId} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
              || (request.auth.token.email == "pupainis@gmail.com" && request.auth.token.email_verified == true));
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.token.email == "pupainis@gmail.com" && request.auth.token.email_verified == true;
      }
    }

    // Admina panelim: visu spēlētāju raundi vienā vaicājumā
    match /{path=**}/sala_rounds/{roundId} {
      allow read: if request.auth != null && request.auth.token.email == "pupainis@gmail.com" && request.auth.token.email_verified == true;
    }

    // ===== REIZRĒĶINA SALA — beigas =====
  }
}
